# ================================
# Stage 1: git clone
# ================================
FROM alpine:3.19 AS builder

RUN apk add --no-cache git

ARG GIT_REPO=https://github.com/cloud-sue/petclinic_web.git
ARG GIT_BRANCH=main


RUN git clone --branch ${GIT_BRANCH} --depth 1  ${GIT_REPO} /frontend

# ================================
# Stage 2: nginx serving
# ================================
FROM nginx:1.25-alpine

# PHP-FPM 및 필요한 확장 설치 (curl 포함)
RUN apk add --no-cache \
    php82 \
    php82-fpm \
    php82-curl \
    php82-mysqli \
    php82-json \
    php82-openssl \
    supervisor

# 기본 설정 제거
RUN rm /etc/nginx/conf.d/default.conf

# nginx 설정 복사
COPY nginx.conf /etc/nginx/nginx.conf
COPY conf.d/default.conf /etc/nginx/conf.d/default.conf

# Stage 1에서 받은 HTML 복사
# repo 구조에 따라 경로 조정 (예: /app/dist, /app/public, /app/build)
COPY --from=builder /frontend /usr/share/nginx/html

# Supervisor 설정 (Nginx와 PHP-FPM을 동시에 실행)
RUN mkdir -p /var/log/supervisor
COPY supervisor.conf /etc/supervisor/conf.d/supervisord.conf

# PHP-FPM 설정 수정 (Nginx와 통신할 수 있게 조정)
RUN sed -i 's/listen = 127.0.0.1:9000/listen = 9000/g' /etc/php82/php-fpm.d/www.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1

#CMD ["nginx", "-g", "daemon off;"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]